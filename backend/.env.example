SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=usuario@example.com
SMTP_PASSWORD=cambiar_por_una_clave_segura
SMTP_FROM_EMAIL=usuario@example.com
SMTP_FROM_NAME=Sistema de Registro de Asistencia
SMTP_REPLY_TO=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

ONLYOFFICE_PUBLIC_URL=http://localhost:8086
ONLYOFFICE_STORAGE_BASE_URL=http://host.docker.internal:8000
ONLYOFFICE_JWT_SECRET=cambiar_por_el_mismo_secreto_del_documentserver
ONLYOFFICE_TOKEN_EXPIRE_MINUTES=30
ONLYOFFICE_TEMP_FILE_EXPIRE_MINUTES=60

# GCS: Development (no se conecta a los flujos actuales)
GCS_ENVIRONMENT=development
GCS_PROJECT_ID=calco-sa-508817
GCS_BUCKET=calco-storage
GCS_PREFIX=assistanceApp_dev/
GCS_AUTH_MODE=hmac
GCS_ENDPOINT=https://storage.googleapis.com
# Configurar solo en el entorno privado del backend. No versionar valores reales.
GCS_HMAC_ACCESS_KEY=
GCS_HMAC_SECRET_KEY=
GCS_TIMEOUT_SECONDS=30
GCS_SIGNING_SERVICE_ACCOUNT_EMAIL=
# QA: GCS_ENVIRONMENT=qa, GCS_PREFIX=assistanceApp_qa/, GCS_AUTH_MODE=adc.
# QA usa la identidad de la VM: no necesita las dos variables HMAC.
# GCS_SIGNING_SERVICE_ACCOUNT_EMAIL es opcional; por defecto firma la cuenta de la VM.
